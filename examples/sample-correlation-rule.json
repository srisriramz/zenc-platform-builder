  "enabled_by": "user-demo-soc-lead-01",
  "rule_type": "sequence",
  "definition": {
    "steps": [
      { "match": "process_creation", "parent_image_contains": "WINWORD.EXE|EXCEL.EXE|OUTLOOK.EXE" },
      { "match": "process_creation", "image_contains": "powershell.exe", "command_line_contains": "-enc" }
    ],
    "within_seconds": 30
  },
  "severity": "high",
  "attack_mapping": [
    { "tactic": "execution", "technique_id": "T1059.001", "technique_name": "PowerShell" }
  ],
