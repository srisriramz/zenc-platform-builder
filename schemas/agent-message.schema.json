{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenc.example/schemas/agent-message.schema.json",
  "title": "Agent Message",
  "description": "One agent's single turn within an agent-run. Every agent output must validate against this shape before it reaches a human or drafts an action request.",
  "type": "object",
  "required": [
    "message_id", "agent_run_id", "agent_name", "tenant_id", "occurred_at",
    "prompt_version", "tool_version", "input_ref", "tool_calls", "claim",
    "confidence", "evidence"
  ],
  "properties": {
    "message_id": { "type": "string" },
    "agent_run_id": { "type": "string" },
    "agent_name": {
      "type": "string",
      "enum": [
        "intake-agent", "triage-agent", "enrichment-agent",
        "investigation-agent", "hunt-agent", "response-planner-agent",
        "detection-engineer-agent", "assessment-assistant-agent",
        "reporting-agent", "digital-advisor-agent",
        "qa-governance-agent", "supervisor"
      ]
    },
    "tenant_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "prompt_version": { "type": "string" },
    "tool_version": { "type": "string" },
    "rule_or_playbook_version": {
      "type": "string",
      "description": "If applicable to this agent's task."
    },
    "input_ref": {
      "type": "string",
      "description": "Pointer to what this agent was given (case_id, alert envelope_id, hunt hypothesis, etc.) — not the raw content inline."
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_name", "called_at"],
        "properties": {
          "tool_name": { "type": "string" },
          "called_at": { "type": "string", "format": "date-time" },
          "scope_or_bound": {
            "type": "string",
            "description": "The query scope/time range/volume bound actually applied to this call."
          }
        }
      }
    },
    "claim": {
      "type": "string",
      "description": "The agent's concise conclusion/recommendation — never the raw hidden reasoning transcript."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_ref", "supports"],
        "properties": {
          "evidence_ref": { "type": "string" },
          "supports": { "type": "boolean", "description": "true = supporting, false = contradictory" },
          "freshness": { "type": "string", "format": "date-time" }
        }
      }
    },
    "escalated": {
      "type": "boolean",
      "description": "True if this agent handed off per an escalation trigger rather than proceeding."
    },
    "escalation_reason": {
      "type": "string",
      "enum": [
        "low_confidence", "action_class_too_high", "contradictory_or_missing_evidence",
        "policy_ambiguous_or_absent", "tool_outside_allowlist"
      ]
    },
    "policy_outcome": { "type": "string" }
  },
  "if": {
    "properties": { "escalated": { "const": true } }
  },
  "then": {
    "required": ["escalation_reason"]
  }
}
