{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenc.example/schemas/agent-run.schema.json",
  "title": "Agent Run",
  "description": "Full trace for an end-to-end agentic task, aggregating one or more agent-messages. Powers /agents/runs/[id] and the analyst-feedback loop.",
  "type": "object",
  "required": [
    "agent_run_id", "tenant_id", "case_id", "started_at", "message_ids",
    "human_touchpoints", "outcome"
  ],
  "properties": {
    "agent_run_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "case_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "message_ids": {
      "type": "array",
      "description": "Ordered list of agent-message IDs making up this run.",
      "items": { "type": "string" }
    },
    "total_tool_calls": { "type": "integer" },
    "elapsed_seconds": { "type": "number" },
    "human_touchpoints": {
      "type": "array",
      "description": "Every point a human reviewed, approved, denied, or corrected something in this run.",
      "items": {
        "type": "object",
        "required": ["principal_id", "action", "at"],
        "properties": {
          "principal_id": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["approved", "denied", "corrected", "reviewed"]
          },
          "at": { "type": "string", "format": "date-time" },
          "note": { "type": "string" }
        }
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["completed", "escalated_pending_human", "denied", "expired", "error"]
    },
    "analyst_feedback": {
      "type": ["object", "null"],
      "description": "Structured correction record, if a human corrected this run's conclusion. See agentic-architecture.md's analyst feedback loop.",
      "properties": {
        "agent_claim_ref": { "type": "string" },
        "human_determination": { "type": "string" },
        "maps_to_closure_classification": {
          "type": "string",
          "enum": ["true_positive", "false_positive", "benign_true_positive", "duplicate", "suppressed"]
        },
        "implicates_version": {
          "type": "string",
          "description": "The rule/playbook/agent version this feedback reflects on, if any."
        }
      }
    }
  }
}
